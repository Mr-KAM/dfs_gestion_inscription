# Copy to .env and change every "change-this" value. Never commit .env.
FLASK_ENV=production
SECRET_KEY=change-this-secret-use-a-long-random-string

# Created at first start if no admin exists (python manage.py create-admin).
ADMIN_EMAIL=admin@dfs.ci
ADMIN_PASSWORD=change-this-password

# PostgreSQL (used by the db container AND by the app to build its connection URL).
POSTGRES_DB=dfs
POSTGRES_USER=dfs
POSTGRES_PASSWORD=change-this-db-password
# Optional: full URL instead of the POSTGRES_* variables above (overrides them).
# DATABASE_URL=postgresql+psycopg://dfs:password@db:5432/dfs

# true behind HTTPS (Dokploy). Browsers accept secure cookies on http://localhost too;
# set false only if you access the app over plain HTTP from another machine.
SESSION_COOKIE_SECURE=true

# Optional defaults (editable later in Administration > KoboToolbox / Paramètres).
KOBO_BASE_URL=https://kf.kobotoolbox.org
KOBO_TOKEN=
KOBO_ASSET_UID=

# The two domains of the app. The domain a request comes in on picks the site: Zeus domain -> Zeus login page
# and Zeus after login; any other -> recruitment. Editable later in Administration > Paramètres.
# Local test of the Zeus domain: ZEUS_BASE_URL=http://zeus.localhost:8000 (*.localhost points to this machine).
RECRUITMENT_BASE_URL=https://recrutement.example.ci
ZEUS_BASE_URL=https://zeus.example.ci

# Outgoing email of each domain (also editable in Paramètres). SECURITY: starttls (port 587) | ssl (465) | none.
RECRUITMENT_SMTP_HOST=
RECRUITMENT_SMTP_PORT=587
RECRUITMENT_SMTP_USER=
RECRUITMENT_SMTP_PASSWORD=
RECRUITMENT_SMTP_SENDER=Recrutement DFS <recrutement@example.ci>
RECRUITMENT_SMTP_SECURITY=starttls
ZEUS_SMTP_HOST=
ZEUS_SMTP_PORT=587
ZEUS_SMTP_USER=
ZEUS_SMTP_PASSWORD=
ZEUS_SMTP_SENDER=Zeus DFS <zeus@example.ci>
ZEUS_SMTP_SECURITY=starttls

# Initial password of every candidate account (the candidate must change it at first login).
CANDIDATE_DEFAULT_PASSWORD=00000000

DEFAULT_TECHNICAL_TEST_DURATION=60
TIMEZONE=Africa/Abidjan
EXAM_CODE_PREFIX=DFS
MAX_UPLOAD_MB=10
WEB_CONCURRENCY=3
